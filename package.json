{
  "name": "rollup-plugin-styler",
  "version": "3.0.1",
  "description": "Universal Rollup plugin for styles: PostCSS, Sass, Less, Stylus and more",
  "keywords": [
    "rollup",
    "rollup-plugin",
    "css",
    "css-modules",
    "postcss",
    "sass",
    "scss",
    "less",
    "stylus"
  ],
  "homepage": "https://github.com/plumelo/rollup-plugin-styler#readme",
  "bugs": {
    "url": "https://github.com/plumelo/rollup-plugin-styler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plumelo/rollup-plugin-styler.git"
  },
  "license": "MIT",
  "author": "Anton Kudryavtsev <boblobl4@gmail.com>",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "prebuild": "shx rm -rf dist",
    "build": "rollup -c --environment NODE_ENV:production",
    "postbuild": "shx cp -r src/shims dist",
    "commit": "commit",
    "predocs": "shx rm -rf docs",
    "docs": "typedoc",
    "docs:publish": "npm run docs && gh-pages -t -d docs",
    "prelint": "prettier -l --write .",
    "lint": "eslint --fix .",
    "lint-staged": "lint-staged",
    "prepare": "is-ci || husky",
    "prepublishOnly": "npm run build",
    "release": "semantic-release",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.0.0",
    "cosmiconfig": "^10.0.0",
    "cssnano": "^9.0.0",
    "fs-extra": "^11.0.0",
    "icss-utils": "^5.1.0",
    "mime-types": "^3.0.0",
    "p-queue": "^10.0.0",
    "postcss": "^8.5.31",
    "postcss-modules-extract-imports": "^3.0.0",
    "postcss-modules-local-by-default": "^4.0.3",
    "postcss-modules-scope": "^3.0.0",
    "postcss-modules-values": "^4.0.0",
    "postcss-value-parser": "^4.2.0",
    "query-string": "^9.5.1",
    "resolve": "^1.22.8",
    "resolve.exports": "^2.0.0",
    "source-map-js": "^1.0.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^8.0.7",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-angular": "^21.0.0",
    "@commitlint/prompt-cli": "^21.0.0",
    "@eslint/js": "^10.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/less": "^3.0.6",
    "@types/mime-types": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/resolve": "^1.20.5",
    "@types/stylus": "^0.48.42",
    "@types/uglifycss": "^0.0.11",
    "autoprefixer": "^10.4.16",
    "babel-jest": "^30.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-unicorn": "^78.0.0",
    "gh-pages": "~6.1.1",
    "globals": "^17.0.0",
    "husky": "^9.0.0",
    "is-ci": "^4.0.0",
    "jest": "^30.0.0",
    "less": "^4.2.0",
    "lint-staged": "^17.0.0",
    "minireset.css": "^0.0.7",
    "postcss-custom-properties": "^15.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.4.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-lit-css": "^6.0.1",
    "rollup-plugin-node-externals": "^9.0.0",
    "sass": "^1.69.5",
    "shx": "^0.3.4",
    "stylus": "^0.61.0",
    "sugarss": "^5.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "semantic-release": "^25.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0"
  },
  "peerDependencies": {
    "rollup": "^2.63.0 || ^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "js-yaml@^3.13.0": {
      "argparse": "^2.0.0"
    }
  }
}
